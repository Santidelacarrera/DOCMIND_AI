# DocMind AI — local development defaults.
#
#   cp .env.example .env && docker compose up --build
#
# These values work out of the box for a local, throw-away stack (the database is not
# published to the host). NEVER reuse them anywhere reachable from a network:
# staging/production must inject real secrets from a secret manager and set
# ENVIRONMENT=staging|production, which makes the API refuse to start with weak or
# missing configuration (see docs/STAGING.md).

# ---- Application -----------------------------------------------------------
ENVIRONMENT=development
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=100
MAX_PDF_TEXT_CHARS=500000
PROCESSING_TIMEOUT_SECONDS=300
STUCK_JOB_SECONDS=900
QUEUED_STUCK_SECONDS=300
MAX_JOB_RECOVERIES=3
FREE_PAGES_PER_MONTH=20

# ---- PostgreSQL (the compose `db` service) ---------------------------------
POSTGRES_DB=docmind
POSTGRES_USER=docmind
POSTGRES_PASSWORD=docmind-local-dev-only
DATABASE_URL=postgresql+psycopg://docmind:docmind-local-dev-only@db:5432/docmind

# ---- Redis (the compose `redis` service) -----------------------------------
# Staging/production: use rediss:// with a password.
REDIS_URL=redis://redis:6379/0

# ---- Object storage ---------------------------------------------------------
# local: files live on the `documents` volume (development only).
# s3:    any S3-compatible private bucket (AWS S3, Supabase Storage, MinIO...).
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/data/documents
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_KMS_KEY_ID=
# Inject at runtime from a secret manager; never commit values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---- OCR --------------------------------------------------------------------
MAX_OCR_PAGES=25
OCR_TIMEOUT_SECONDS=60

# ---- LLM --------------------------------------------------------------------
# mock: deterministic fixture, no network. openai: requires OPENAI_API_KEY. gemini: requires GEMINI_API_KEY.
LLM_PROVIDER=mock
OPENAI_API_KEY=
# Google Gemini (LLM_PROVIDER=gemini), through its OpenAI-compatible endpoint.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_INPUT_PRICE_PER_1M=0.30
GEMINI_OUTPUT_PRICE_PER_1M=2.50
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_MAX_INPUT_CHARS=100000
OPENAI_MAX_CONCURRENCY=4

# ---- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Staging/production require >= 32 characters.
JWT_SECRET=local-development-only-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_ENABLED=true
CORS_ORIGINS=http://localhost:3000
# Requests per minute per client address (login is also limited per account).
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_UPLOAD=20
RATE_LIMIT_API=120
# Staging/production must use clamav (clamd reachable at CLAMAV_HOST:CLAMAV_PORT).
ANTIVIRUS_PROVIDER=disabled
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ---- Email (workspace invitations) ------------------------------------------
# Empty SMTP_HOST logs invitation emails to the console instead of sending them
# (development only; staging/production require SMTP_HOST to be set).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=DocMind AI <no-reply@docmind.ai>
INVITATION_EXPIRY_HOURS=72
# Used to build the link inside invitation emails; must be HTTPS in staging/production.
FRONTEND_BASE_URL=http://localhost:3000

# ---- Observability ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_SERVICE_NAME=docmind-api
# Unset disables tracing entirely. Point this at an OTLP/HTTP collector
# (e.g. http://otel-collector:4318/v1/traces) to enable it; see
# docs/OBSERVABILITY.md and the `observability` compose profile.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Web (inlined into the browser bundle at build time: never a secret) ----
NEXT_PUBLIC_API_URL=http://localhost:8000

# Quality gates (see docs/EVALUATION.md)
CONFIDENCE_REVIEW_THRESHOLD=0.70
OCR_REVIEW_THRESHOLD=0.80
# review = keep schema-violating answers but force human review; reject = fail the job
SCHEMA_VIOLATION_POLICY=review
LLM_INVALID_OUTPUT_RETRIES=1
# Approximate USD per 1M tokens, used for the per-run cost estimate; set your provider's current prices
OPENAI_INPUT_PRICE_PER_1M=0.15
OPENAI_OUTPUT_PRICE_PER_1M=0.60

# Retention (see docs/DATA_RETENTION.md)
RETENTION_DELETED_DAYS=30
RETENTION_DOCUMENT_DAYS=0

# Vector index (docs/INGESTION.md). Leave QDRANT_URL empty to disable indexing and vector deletion.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=docmind_chunks
PII_MASKING_KEY=
# rules = names/addresses by context + your own terms; spacy = statistical NER (pip install '.[ner]' + model)
PII_DETECTORS=rules
PII_SPACY_MODEL=en_core_web_sm
PII_EXTRA_TERMS=
# local (on this host) | openai (external: needs the next three) | hashing (development only)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_ALLOW_EXTERNAL=false
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_ALLOWED_HOSTS=api.openai.com


# Storage reconciliation (docs/DATA_RETENTION.md): orphaned objects are reported daily; deleting is opt-in.
STORAGE_RECONCILE_GRACE_HOURS=24
STORAGE_RECONCILE_DELETE=false
STORAGE_RECONCILE_MAX_DELETE_FRACTION=0.5

# ContextRAG sync (docs/CONTEXTRAG_INTEGRATION.md). Disabled by default; events are recorded either way.
CONTEXTRAG_SYNC_ENABLED=false
# CONTEXTRAG_URL=https://contextrag.example.internal
# CONTEXTRAG_ALLOWED_HOSTS=contextrag.example.internal
# Path to a JSON file {"<organization uuid>": "<contextrag admin key>"} kept outside the repository.
# CONTEXTRAG_KEYS_FILE=/run/secrets/contextrag-keys.json
# masked (default) or raw; raw needs CONTEXTRAG_ALLOW_RAW_TEXT=true and is refused in staging/production.
CONTEXTRAG_CONTENT_MODE=masked
CONTEXTRAG_ALLOW_RAW_TEXT=false
CONTEXTRAG_MAX_ATTEMPTS=25
