# Development template only. Do not deploy it or commit a populated .env file.
POSTGRES_DB=docmind
POSTGRES_USER=docmind
ENVIRONMENT=development
POSTGRES_PASSWORD=<development-password-from-secret-manager>
DATABASE_URL=postgresql+psycopg://<db-user>:<db-password>@<db-host>:5432/<db-name>
REDIS_URL=redis://:<redis-password>@<redis-host>:6379/0
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/data/documents
# Staging/production: STORAGE_PROVIDER=s3 and runtime workload identity or injected SDK credentials.
S3_BUCKET=<private-bucket-name>
S3_ENDPOINT_URL=
S3_REGION=<cloud-region>
S3_KMS_KEY_ID=<kms-key-identifier>
# Supabase S3 access keys: inject at runtime; never commit their values.
AWS_ACCESS_KEY_ID=<secret-manager-reference>
AWS_SECRET_ACCESS_KEY=<secret-manager-reference>
AWS_SESSION_TOKEN=
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=100
MAX_PDF_TEXT_CHARS=500000
MAX_OCR_PAGES=25
OCR_TIMEOUT_SECONDS=60
PROCESSING_TIMEOUT_SECONDS=300
STUCK_JOB_SECONDS=900
FREE_PAGES_PER_MONTH=20
CONFIDENCE_REVIEW_THRESHOLD=0.70
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=mock
OCR_PROVIDER=tesseract
JWT_SECRET=<inject-at-least-32-random-characters>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_ENABLED=true
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_UPLOAD=20
RATE_LIMIT_API=120
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_MAX_INPUT_CHARS=100000
OPENAI_MAX_CONCURRENCY=4
# Staging/production must use clamav (or another implemented provider).
ANTIVIRUS_PROVIDER=disabled
CLAMAV_HOST=<clamav-service-host>
CLAMAV_PORT=3310
